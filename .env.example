# Copy to .env.local and fill in. Never commit the real file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RETELL_API_KEY=
# Public URL of the deployed app, used to check Twilio signatures
APP_URL=https://app.rightobooked.com.au
# Random string; Vercel cron sends it as a Bearer token
CRON_SECRET=
# Weekly cost report goes to this mobile, sent from one of our Twilio numbers
ADMIN_MOBILE=
ADMIN_FROM_NUMBER=
# Cost estimates in USD (optional; defaults shown). Check the Retell and Twilio billing pages.
COST_PER_MINUTE_USD=0.12
COST_PER_TEXT_USD=0.065
COST_PER_NUMBER_MONTH_USD=6
USD_TO_AUD=1.55
